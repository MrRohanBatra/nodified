# Local development configuration. Spring Boot uses these only when your IDE,
# terminal, Docker Compose, or hosting provider exports them as environment variables.
SPRING_PROFILES_ACTIVE=local
JWT_ISSUER_URI=http://localhost:8081

# Local PostgreSQL fallback: these values are already the defaults in application-local.yml.
NODIFIED_DB_URL=jdbc:postgresql://localhost:5432/nodified
NODIFIED_DB_USERNAME=nodified
NODIFIED_DB_PASSWORD=change-me

# To use your Supabase project locally instead, replace the three values above.
# In Supabase: Connect -> Session pooler -> JDBC. Keep sslmode=require.
# NODIFIED_DB_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres?sslmode=require
# NODIFIED_DB_USERNAME=postgres.<project-reference>
# NODIFIED_DB_PASSWORD=<database-password-created-with-the-project>

FLYWAY_ENABLED=true
