# ==============================================================================
# Nodified Environment Configuration (.env)
# Each service has its own completely independent variables.
# Services never share environment variables.
# ==============================================================================

# Active Spring profile ('local' for local dev, 'prod' for deployed environments)
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------------------------
# 1. Gateway Service (services/apps/gateway)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
GATEWAY_JWT_ISSUER_URI=http://localhost:8081

# ------------------------------------------------------------------------------
# 2. Identity Service (services/apps/identity)
# ------------------------------------------------------------------------------
IDENTITY_PORT=8081
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/nodified
IDENTITY_DB_USERNAME=nodified
IDENTITY_DB_PASSWORD=change-me
IDENTITY_DB_SCHEMA=identity
IDENTITY_DDL_AUTO=update
IDENTITY_JWT_ISSUER_URI=http://localhost:8081

# ------------------------------------------------------------------------------
# 3. Monitor Service (services/apps/monitor)
# ------------------------------------------------------------------------------
MONITOR_PORT=8082
MONITOR_DB_URL=jdbc:postgresql://localhost:5432/nodified
MONITOR_DB_USERNAME=nodified
MONITOR_DB_PASSWORD=change-me
MONITOR_DB_SCHEMA=monitor
MONITOR_DDL_AUTO=update
MONITOR_JWT_ISSUER_URI=http://localhost:8081
